# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Resend
RESEND_API_KEY=re_your-api-key

# Email Configuration
CONTACT_EMAIL=hello@beam.com

# LibreTranslate (optional - defaults to public instance)
NEXT_PUBLIC_LIBRETRANSLATE_URL=https://libretranslate.com

# ═══════════════════════════════════════════════════════════════════
# IRA - BEAM AI ASSISTANT (Hugging Face)
# ═══════════════════════════════════════════════════════════════════

# Hugging Face API - Get from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your-api-key
HF_MODEL_REPO=your-username/ira-beam-assistant

# Inference Configuration
HF_INFERENCE_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Ira Behavior
IRA_MAX_TOKENS=1024
IRA_TEMPERATURE=0.7
